# Neon Postgres
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Google Gemini (AI Studio)
GEMINI_API_KEY=

# Google OAuth app (Gmail hub ufficio)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI da registrare in Google Cloud (es. https://tuodominio.vercel.app/api/google/callback)
GOOGLE_REDIRECT_URI=
# Opzionale URL pubblico app (per redirect OAuth e link pacchetto segreteria)
NEXT_PUBLIC_APP_URL=
# Nome prodotto in UI (default Prontopratica)
# NEXT_PUBLIC_APP_NAME=Prontopratica
# Email mostrata in Privacy/Terms (OAuth Google branding)
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@tuodominio.it


# Cloudflare R2 (storage documenti — obbligatorio)
# Dashboard Cloudflare → R2 → Create bucket → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=euroansa
# Opzionale (default: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=

# Legacy opzionale: un solo token globale (usato solo se NESSUN utente ha collegato Google)
# Preferisci: Impostazioni → Collega Google
# GOOGLE_REFRESH_TOKEN=

# Obbligatorio: pezzo cercato nell'oggetto mail clienti (nessun default in codice)
GMAIL_SUBJECT_TAG=

# Vercel Cron protection
CRON_SECRET=

# Defaults
SECRETARY_EMAIL_DEFAULT=segreteria@example.com
ADMIN_EMAIL=admin@prontopratica.local
ADMIN_PASSWORD=cambia-questa-password

# Session signing (min 32 chars)
AUTH_SECRET=genera-una-stringa-segreta-lunga
