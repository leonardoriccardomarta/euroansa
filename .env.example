# Neon Postgres
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Google Gemini (AI Studio)
GEMINI_API_KEY=

# Google OAuth app (Gmail hub ufficio)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI da registrare in Google Cloud (es. https://tuodominio.vercel.app/api/google/callback)
GOOGLE_REDIRECT_URI=
# Opzionale URL pubblico app (per redirect OAuth e link pacchetto segreteria)
NEXT_PUBLIC_APP_URL=

# Vercel Blob (storage documenti sul sito — obbligatorio)
# Crea uno Blob Store su Vercel → Settings → Storage → Blob → token
BLOB_READ_WRITE_TOKEN=

# Legacy opzionale: un solo token globale (usato solo se NESSUN utente ha collegato Google)
# Preferisci: Impostazioni → Collega Google
# GOOGLE_REFRESH_TOKEN=

# Oggetto email clienti da elaborare (esatto pezzo cercato nell'oggetto)
# Default consigliato: [EUROANSA-MUTUO]
GMAIL_SUBJECT_TAG=[EUROANSA-MUTUO]

# Vercel Cron protection
CRON_SECRET=

# Defaults
SECRETARY_EMAIL_DEFAULT=segreteria@example.com
ADMIN_EMAIL=admin@euroansa.local
ADMIN_PASSWORD=cambia-questa-password

# Session signing (min 32 chars)
AUTH_SECRET=genera-una-stringa-segreta-lunga
